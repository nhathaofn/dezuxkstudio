# Patterns that name directories are anchored with a leading "/" so they never
# hide source folders that happen to share the name (e.g. src/features/logs).

# Secrets & local configuration
AGENTS.md
/.agents/teamwork/
/config.json
*.env
.env
.env.*
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.token
/secrets/

# Build outputs
/bin/
/build/bin/
/build/.gotmp/
/dist/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.app
*.zip
*.tar.gz
*.sha256

# Frontend
/frontend/node_modules/
/frontend/dist/
/frontend/package.json.md5
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Wails-generated bindings (regenerated by `wails dev/build`; the app uses src/lib/bridge.ts)
/frontend/wailsjs/go/

# Logs & temporary data
*.log
/logs/
/.temp/
/tmp/

# OS & editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Tool caches
/.task/
*.tsbuildinfo
