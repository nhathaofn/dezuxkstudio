# ═══════════════════════════════════════════════════
# DezuxkStudio Git Ignore Rules
# ═══════════════════════════════════════════════════

# Security & Private Files
AGENTS.md
config.json
*.env
.env
.env.*
*.pem
*.key
*.cert
*.crt
*.pfx
*.token
secrets/

# Build Binaries & Artifacts
bin/
build/bin/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.app
*.zip
*.tar.gz
*.sha256

# Frontend Build & Dependencies
node_modules/
frontend/node_modules/
dist/
frontend/dist/
package.json.md5
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Logging & Temporary Data
*.log
logs/
.temp/
tmp/

# OS & Editor Artifacts
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
